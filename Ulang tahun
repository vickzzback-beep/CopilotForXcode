<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <title>Perayaan Ulang Tahun</title>
  <style>
    body {
      margin: 0;
      padding: 0;
      height: 100vh;
      overflow: hidden;
      font-family: Arial, sans-serif;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;

      /* Background gradient animasi */
      background: linear-gradient(270deg, #ff6f91, #ff9671, #ffc75f, #f9f871);
      background-size: 800% 800%;
      animation: gradientBG 15s ease infinite;
    }

    @keyframes gradientBG {
      0% { background-position: 0% 50%; }
      50% { background-position: 100% 50%; }
      100% { background-position: 0% 50%; }
    }

    h1 {
      font-size: 2em;
      color: white;
      text-shadow: 2px 2px 5px #ff4081;
    }

    .form {
      background: rgba(255,255,255,0.85);
      padding: 20px;
      border-radius: 15px;
      box-shadow: 0 5px 15px rgba(0,0,0,0.3);
      text-align: center;
      z-index: 10;
    }

    .form input {
      margin: 10px;
      padding: 8px;
      border-radius: 8px;
      border: 1px solid #ccc;
    }

    .form button {
      margin-top: 10px;
      padding: 10px 20px;
      border: none;
      border-radius: 8px;
      background: #ff4081;
      color: white;
      font-weight: bold;
      cursor: pointer;
    }

    .hidden { display: none; }

    .cake {
      width: 150px;
      height: 120px;
      background: #ff6f61;
      border-radius: 10px;
      position: relative;
      margin-top: 40px;
      box-shadow: 0 5px 20px rgba(0,0,0,0.3);
      z-index: 5;
    }

    .candle {
      width: 10px;
      height: 40px;
      background: #fff176;
      position: absolute;
      top: -40px;
      left: 50%;
      transform: translateX(-50%);
      border-radius: 3px;
    }

    .flame {
      width: 15px;
      height: 15px;
      background: orange;
      border-radius: 50%;
      position: absolute;
      top: -15px;
      left: 50%;
      transform: translateX(-50%);
      animation: flicker 0.3s infinite;
    }

    @keyframes flicker {
      0% { transform: translateX(-50%) scale(1); opacity: 1; }
      50% { transform: translateX(-50%) scale(1.3); opacity: 0.8; }
      100% { transform: translateX(-50%) scale(1); opacity: 1; }
    }

    .balloon {
      width: 40px;
      height: 50px;
      border-radius: 50%;
      position: absolute;
      bottom: -100px;
      animation: float 6s infinite;
      z-index: 2;
    }

    .balloon::after {
      content: "";
      width: 2px;
      height: 60px;
      background: #333;
      position: absolute;
      top: 50px;
      left: 50%;
      transform: translateX(-50%);
    }

    @keyframes float {
      0% { bottom: -100px; opacity: 0; }
      50% { opacity: 1; }
      100% { bottom: 110%; opacity: 0; }
    }

    .message {
      font-size: 2em;
      color: white;
      margin-top: 20px;
      text-shadow: 2px 2px 5px #ff4081;
      animation: bounce 2s infinite;
      z-index: 5;
    }

    @keyframes bounce {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-15px); }
    }

    /* Konfeti */
    .confetti {
      position: absolute;
      width: 10px;
      height: 10px;
      background: red;
      top: -10px;
      animation: fall linear infinite;
      z-index: 1;
    }

    @keyframes fall {
      to { transform: translateY(110vh) rotate(360deg); }
    }
  </style>
</head>
<body>
  <div class="form" id="form">
    <h1>Masukkan Data Ulang Tahun 🎂</h1>
    <input type="text" id="nama" placeholder="Nama Kamu"><br>
    <input type="number" id="tanggal" placeholder="Tanggal" min="1" max="31">
    <input type="number" id="bulan" placeholder="Bulan" min="1" max="12">
    <input type="number" id="tahun" placeholder="Tahun"><br>
    <button onclick="mulai()">Rayakan 🎉</button>
  </div>

  <div id="perayaan" class="hidden">
    <h1 class="message" id="pesan"></h1>
    <div class="cake">
      <div class="candle"></div>
      <div class="flame"></div>
    </div>

    <!-- Musik otomatis -->
    <audio autoplay loop>
      <source src="lagu-ulangtahun.mp3" type="audio/mpeg">
    </audio>
  </div>

  <script>
    function mulai() {
      let nama = document.getElementById("nama").value;
      let tgl = document.getElementById("tanggal").value;
      let bln = document.getElementById("bulan").value;
      let thn = document.getElementById("tahun").value;

      if (!nama || !tgl || !bln || !thn) {
        alert("Lengkapi semua data dulu ya!");
        return;
      }

      document.getElementById("form").classList.add("hidden");
      document.getElementById("perayaan").classList.remove("hidden");

      let pesan = document.getElementById("pesan");
      pesan.innerHTML = `🎉 Selamat Ulang Tahun ${nama}! 🎂<br>${tgl}-${bln}-${thn}`;

      // Balon terbang
      for (let i = 0; i < 20; i++) {
        let balloon = document.createElement("div");
        balloon.classList.add("balloon");
        balloon.style.left = Math.random() * 100 + "vw";
        balloon.style.background = `hsl(${Math.random()*360}, 70%, 60%)`;
        balloon.style.animationDuration = (4 + Math.random() * 4) + "s";
        document.body.appendChild(balloon);
      }

      // Konfeti jatuh
      for (let i = 0; i < 40; i++) {
        let confetti = document.createElement("div");
        confetti.classList.add("confetti");
        confetti.style.left = Math.random() * 100 + "vw";
        confetti.style.background = `hsl(${Math.random()*360}, 70%, 60%)`;
        confetti.style.width = Math.random() * 8 + 5 + "px";
        confetti.style.height = Math.random() * 8 + 5 + "px";
        confetti.style.animationDuration = (3 + Math.random() * 3) + "s";
        document.body.appendChild(confetti);
      }
    }
  </script>
</body>
</html>
